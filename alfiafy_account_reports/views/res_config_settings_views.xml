<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_alfiafy_account_reports" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.alfiafy.account.reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_default_journals']" position="after">
                <setting id="alfiafy_branch_analytic_account" string="Branch Analytic Account"
                         help="Sales revenue of the session closing entry is tagged with this branch analytic account (branch P&amp;L).">
                    <field name="pos_analytic_account_id" domain="[('company_id', 'in', [company_id, False])]"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
