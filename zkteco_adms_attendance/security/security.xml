<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Access groups and multi-company record rules for the ZKTeco ADMS
        Attendance module. Loaded before ir.access.csv so the groups
        referenced there already exist. The multi-company rules are
        global (group-less) rows of ir.access.csv in Odoo 20.
    -->

    <!-- ================================================================ -->
    <!-- Settings privilege (replaces res.groups.category_id since 19)   -->
    <!-- ================================================================ -->
    <record id="res_groups_privilege_zkteco" model="res.groups.privilege">
        <field name="name">ZKTeco Attendance</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- ================================================================ -->
    <!-- Groups                                                           -->
    <!-- ================================================================ -->
    <record id="group_zkteco_user" model="res.groups">
        <field name="name">ZKTeco Attendance / Read Only</field>
        <field name="privilege_id" ref="res_groups_privilege_zkteco"/>
        <field name="comment">Read-only access to biometric devices, raw punch logs, commands and attendance policies.</field>
    </record>

    <record id="group_zkteco_admin" model="res.groups">
        <field name="name">ZKTeco Attendance / Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_zkteco"/>
        <field name="comment">Full management of biometric devices, policies, commands and log reprocessing.</field>
        <field name="implied_ids" eval="[(4, ref('group_zkteco_user'))]"/>
    </record>


    <!-- Ensure the default administrator can manage devices out of the box. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_zkteco_admin'))]"/>
    </record>

</odoo>
