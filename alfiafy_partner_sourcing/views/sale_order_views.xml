<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_partner_sourcing" model="ir.ui.view">
        <field name="name">sale.order.form.alfiafy.partner.sourcing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//column[@name='price_unit']" position="before">
                <field name="sourcing_type" widget="badge" optional="show"
                       decoration-success="sourcing_type == 'partner'"
                       decoration-warning="sourcing_type == 'outside'"
                       decoration-info="sourcing_type == 'mixed'"
                       invisible="display_type"/>
            </xpath>
        </field>
    </record>
</odoo>
