<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_partner_sourcing" model="ir.ui.view">
        <field name="name">account.move.form.alfiafy.partner.sourcing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- customer invoices / credit notes: set from the lots, editable on manual lines -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="before">
                <field name="sourcing_type" widget="badge" optional="show"
                       decoration-success="sourcing_type == 'partner'"
                       decoration-warning="sourcing_type == 'outside'"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"
                       invisible="display_type != 'product'"/>
            </xpath>
        </field>
    </record>
</odoo>
