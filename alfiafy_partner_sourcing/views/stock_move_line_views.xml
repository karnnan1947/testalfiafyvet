<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delivery / receipt "Details" dialog: sourcing of the lot picked -->
    <record id="view_stock_move_line_operation_tree_partner_sourcing" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.alfiafy.partner.sourcing</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="sourcing_type" widget="badge" readonly="1"
                       column_invisible="parent.has_tracking not in ['lot', 'serial']"
                       groups="stock.group_production_lot"
                       decoration-success="sourcing_type == 'partner'"
                       decoration-warning="sourcing_type == 'outside'"/>
            </xpath>
        </field>
    </record>

    <!-- Detailed operations list of a transfer -->
    <record id="view_stock_move_line_detailed_operation_tree_partner_sourcing" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.list.alfiafy.partner.sourcing</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="sourcing_type" widget="badge" readonly="1" optional="show"
                       groups="stock.group_production_lot"
                       decoration-success="sourcing_type == 'partner'"
                       decoration-warning="sourcing_type == 'outside'"/>
            </xpath>
        </field>
    </record>

    <!-- Moves history -->
    <record id="view_move_line_tree_partner_sourcing" model="ir.ui.view">
        <field name="name">stock.move.line.list.alfiafy.partner.sourcing</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="sourcing_type" widget="badge" optional="show"
                       groups="stock.group_production_lot"
                       decoration-success="sourcing_type == 'partner'"
                       decoration-warning="sourcing_type == 'outside'"/>
            </xpath>
        </field>
    </record>
</odoo>
