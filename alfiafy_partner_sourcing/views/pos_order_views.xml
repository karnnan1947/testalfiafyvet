<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_partner_sourcing" model="ir.ui.view">
        <field name="name">pos.order.form.alfiafy.partner.sourcing</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list/field[@name='qty']" position="before">
                <field name="sourcing_type" widget="badge" optional="show" readonly="1"
                       decoration-success="sourcing_type == 'partner'"
                       decoration-warning="sourcing_type == 'outside'"
                       decoration-info="sourcing_type == 'mixed'"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_line_partner_sourcing" model="ir.ui.view">
        <field name="name">pos.order.line.list.alfiafy.partner.sourcing</field>
        <field name="model">pos.order.line</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_line"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty']" position="before">
                <field name="sourcing_type" widget="badge" optional="show"
                       decoration-success="sourcing_type == 'partner'"
                       decoration-warning="sourcing_type == 'outside'"
                       decoration-info="sourcing_type == 'mixed'"/>
            </xpath>
        </field>
    </record>
</odoo>
