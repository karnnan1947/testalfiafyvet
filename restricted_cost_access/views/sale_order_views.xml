<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Odoo 20 sale_margin shows margin / margin % inside the price_unit
             column of the order lines and the cost (purchase_price) after the
             discount column. There is no order-level margin block any more. -->
        <record id="sale_margin_sale_order_inherit_hide_cost" model="ir.ui.view">
            <field name="name">sale.order.form.hide.cost.margin</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_margin.sale_margin_sale_order"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//list//field[@name='purchase_price']" position="attributes">
                    <attribute name="groups">restricted_cost_access.group_manager_cost</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='margin']" position="attributes">
                    <attribute name="groups">restricted_cost_access.group_manager_cost</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='margin_percent']" position="attributes">
                    <attribute name="groups">restricted_cost_access.group_manager_cost</attribute>
                </xpath>
            </field>
        </record>

        <!-- Quotation templates: product-less lines carry a cost -->
        <record id="sale_order_template_form_hide_cost" model="ir.ui.view">
            <field name="name">sale.order.template.form.hide.cost</field>
            <field name="model">sale.order.template</field>
            <field name="inherit_id" ref="sale_margin.sale_order_template_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sale_order_template_line_ids']/list/field[@name='purchase_price']" position="attributes">
                    <attribute name="groups">restricted_cost_access.group_manager_cost</attribute>
                </xpath>
            </field>
        </record>

        <!-- "Projected Margins" sale report (new in Odoo 20) -->
        <record id="sale_report_projected_margins_list_hide_cost" model="ir.ui.view">
            <field name="name">sale.report.projected.margins.list.hide.cost</field>
            <field name="model">sale.report</field>
            <field name="inherit_id" ref="sale_margin.sale_report_projected_margins_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='purchase_price']" position="attributes">
                    <attribute name="groups">restricted_cost_access.group_manager_cost</attribute>
                </xpath>
                <xpath expr="//field[@name='margin']" position="attributes">
                    <attribute name="groups">restricted_cost_access.group_manager_cost</attribute>
                </xpath>
                <xpath expr="//field[@name='margin_percent']" position="attributes">
                    <attribute name="groups">restricted_cost_access.group_manager_cost</attribute>
                </xpath>
            </field>
        </record>
        <record id="sale_margin.action_order_report_projected_margins" model="ir.actions.act_window">
            <field name="group_ids" eval="[(4, ref('restricted_cost_access.group_manager_cost'))]"/>
        </record>
    </data>
</odoo>
