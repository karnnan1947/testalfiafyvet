<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Only the Stock Manager can validate a scrap (write-off) -->
    <record id="view_scrap_move_form_alfiafy_stock" model="ir.ui.view">
        <field name="name">stock.scrap.move.form.alfiafy.stock</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_scrap']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
            <xpath expr="//footer/button[@name='action_scrap']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
