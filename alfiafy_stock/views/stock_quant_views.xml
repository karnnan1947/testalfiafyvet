<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable_alfiafy_stock" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.alfiafy.stock</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">variance_exceeded</attribute>
            </xpath>
            <field name="inventory_diff_quantity" position="after">
                <field name="variance_exceeded" column_invisible="True"/>
                <field name="variance_value" optional="show" invisible="not inventory_quantity_set"
                       decoration-danger="variance_exceeded" decoration-bf="variance_exceeded"/>
                <field name="approval_state" widget="badge" optional="show" readonly="1"
                       decoration-warning="approval_state == 'to_approve'"
                       decoration-success="approval_state == 'approved'"
                       decoration-muted="approval_state == 'draft'"/>
            </field>
        </field>
    </record>

    <record id="quant_search_view_alfiafy_stock" model="ir.ui.view">
        <field name="name">stock.quant.search.alfiafy.stock</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <filter name="to_apply" position="after">
                <filter name="pending_variance_approval" string="Pending Variance Approvals"
                        domain="[('approval_state', '=', 'to_approve')]"/>
            </filter>
        </field>
    </record>
</odoo>
