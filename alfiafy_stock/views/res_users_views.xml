<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_alfiafy_stock_visibility" model="ir.ui.view">
        <field name="name">res.users.form.alfiafy.stock.visibility</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="visible_stock_warehouse_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       groups="base.group_erp_manager,stock.group_stock_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
