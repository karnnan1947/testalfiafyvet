<templates id="template" xml:space="preserve">
    <t t-name="pos_multi_uom_price.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button class="btn btn-secondary btn-lg lh-lg o_uom_selector_button"
                    t-att-disabled="!this.pos.getOrder()?.getSelectedOrderline()"
                    t-on-click="() => this.onClickUOMSelector()">
                <i class="oi me-1" data-icon="shopping_basket" aria-hidden="true"/>UoM
            </button>
        </xpath>
    </t>
    <t t-name="pos_multi_uom_price.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button class="btn btn-secondary btn-lg flex-shrink-0 o_uom_selector_button"
                    t-att-disabled="!this.pos.getOrder()?.getSelectedOrderline()"
                    t-on-click="() => this.onClickUOMSelector()">
                <i class="oi me-1" data-icon="shopping_basket" aria-hidden="true"/>UoM
            </button>
        </xpath>
    </t>
</templates>
