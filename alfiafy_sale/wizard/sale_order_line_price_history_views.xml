<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_price_history_view_form" model="ir.ui.view">
        <field name="name">sale.order.line.price.history.form</field>
        <field name="model">sale.order.line.price.history</field>
        <field name="arch" type="xml">
            <form string="Customer Price History" create="0" edit="0">
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="uom_id" readonly="1" groups="uom.group_uom"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="current_price_unit" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                        <field name="current_discount" readonly="1" invisible="not current_discount"/>
                        <field name="current_net_price" readonly="1"/>
                    </group>
                </group>
                <separator string="Last 5 confirmed sales to this customer"/>
                <field name="line_ids" readonly="1" nolabel="1">
                    <list create="0" delete="0" no_open="1">
                        <field name="order_ref"/>
                        <field name="order_date" options="{'show_time': false}"/>
                        <field name="salesperson_id" optional="hide"/>
                        <field name="product_uom_qty"/>
                        <field name="uom_id" groups="uom.group_uom"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="price_unit"/>
                        <field name="discount"/>
                        <field name="net_price"/>
                        <field name="comparison" widget="badge"
                               decoration-warning="comparison == 'higher'"
                               decoration-info="comparison == 'lower'"
                               decoration-muted="comparison == 'same'"/>
                    </list>
                </field>
                <div class="text-muted" invisible="line_ids">
                    First time sale: this product was never sold to this customer.
                </div>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
