<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_alfiafy_pos" model="ir.ui.view">
        <field name="name">product.template.form.alfiafy.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']/group/group[@name='pos']" position="after">
                <group name="alfiafy_pos_restrictions" string="Point of Sale Restrictions">
                    <label for="max_pos_qty"/>
                    <div class="o_row">
                        <field name="max_pos_qty" class="oe_inline"/>
                        <field name="uom_name" class="oe_inline"/>
                    </div>
                    <div class="text-muted" colspan="2" invisible="max_pos_qty">
                        No limit: any quantity can be sold at the counter.
                    </div>
                    <div class="text-muted" colspan="2" invisible="not max_pos_qty">
                        Larger quantities are wholesale and must be sold through Sales.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
