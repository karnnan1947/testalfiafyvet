<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="alfiafy_target_species_view_list" model="ir.ui.view">
        <field name="name">alfiafy.target.species.list</field>
        <field name="model">alfiafy.target.species</field>
        <field name="arch" type="xml">
            <list string="Target Species" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="alfiafy_target_species_action" model="ir.actions.act_window">
        <field name="name">Target Species</field>
        <field name="res_model">alfiafy.target.species</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="alfiafy_target_species_menu"
              name="Target Species"
              parent="stock.menu_product_in_config_stock"
              action="alfiafy_target_species_action"
              sequence="40"/>
</odoo>
