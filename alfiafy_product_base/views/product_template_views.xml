<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product form: Arabic name under the title + "Veterinary Details" tab.
         product_normal_form_view (variants) is built on this view, so the
         variant form gets the same fields. -->
    <record id="product_template_form_view_alfiafy" model="ir.ui.view">
        <field name="name">product.template.form.alfiafy.product.base</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <h4 class="mt-1">
                    <field name="name_ar" placeholder="Arabic name / الاسم بالعربية"/>
                </h4>
            </xpath>
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Veterinary Details" name="alfiafy_vet_details">
                    <group>
                        <group string="Classification" name="alfiafy_classification">
                            <field name="vet_item_type"/>
                            <field name="active_ingredient" placeholder="e.g. Ivermectin"/>
                            <field name="target_species_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="dosage_form"/>
                            <field name="strength" placeholder="e.g. 1% w/v"/>
                        </group>
                        <group string="Source and Handling" name="alfiafy_source">
                            <field name="manufacturer_id"
                                   context="{'default_is_company': True}"/>
                            <field name="supplier_id"
                                   context="{'default_is_company': True, 'res_partner_search_mode': 'supplier'}"/>
                            <field name="storage_condition"/>
                            <field name="prescription_required"/>
                        </group>
                    </group>
                    <group string="Arabic Description" name="alfiafy_description_ar">
                        <field name="description_ar" nolabel="1" colspan="2"
                               placeholder="الوصف بالعربية"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product search: molecule, Arabic name, manufacturer, supplier, species -->
    <record id="product_template_search_view_alfiafy" model="ir.ui.view">
        <field name="name">product.template.search.alfiafy.product.base</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="active_ingredient"/>
                <field name="name_ar"/>
                <field name="manufacturer_id"/>
                <field name="supplier_id"/>
                <field name="target_species_ids"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_categ_id']" position="after">
                <filter string="Manufacturer" name="group_by_manufacturer" context="{'group_by': 'manufacturer_id'}"/>
                <filter string="Supplier" name="group_by_supplier" context="{'group_by': 'supplier_id'}"/>
                <filter string="Item Type" name="group_by_vet_item_type" context="{'group_by': 'vet_item_type'}"/>
            </xpath>
        </field>
    </record>

    <!-- Product (template) list -->
    <record id="product_template_tree_view_alfiafy" model="ir.ui.view">
        <field name="name">product.template.list.alfiafy.product.base</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="name_ar" optional="hide"/>
                <field name="active_ingredient" optional="show"/>
                <field name="manufacturer_id" optional="show"/>
                <field name="supplier_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Product variant list -->
    <record id="product_product_tree_view_alfiafy" model="ir.ui.view">
        <field name="name">product.product.list.alfiafy.product.base</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="active_ingredient" optional="show"/>
                <field name="manufacturer_id" optional="show"/>
                <field name="supplier_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
