<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_alfiafy_documents" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.alfiafy.documents</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="documents.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='documents']" position="inside">
                <block title="Regulatory Compliance" id="alfiafy_regulatory_compliance">
                    <setting id="compliance_alert_recipients" string="Compliance Alert Recipients" company_dependent="1"
                             help="Users who receive a To-Do activity and an e-mail when a license enters its alert window or expires.">
                        <field name="compliance_manager_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
