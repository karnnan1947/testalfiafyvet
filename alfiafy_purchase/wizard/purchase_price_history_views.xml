<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_price_history_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.price.history.wizard.form</field>
        <field name="model">purchase.price.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Price History">
                <group>
                    <group>
                        <field name="product_id" options="{'no_open': True}"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="current_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="last_purchase_price"/>
                        <field name="price_trend" widget="badge"
                               decoration-danger="price_trend == 'up'"
                               decoration-success="price_trend == 'down'"
                               decoration-info="price_trend == 'same'"
                               invisible="not price_trend"/>
                    </group>
                </group>
                <separator string="Last 10 confirmed purchases - all vendors"/>
                <field name="history_line_ids" nolabel="1" readonly="1">
                    <list create="0" delete="0" edit="0" no_open="1">
                        <field name="date_approve" string="Date" options="{'show_time': false}"/>
                        <field name="order_id" string="PO Number"/>
                        <field name="partner_id" string="Vendor"/>
                        <field name="product_qty" string="Quantity"/>
                        <field name="uom_id" string="Unit" groups="uom.group_uom"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="price_unit" string="Unit Price" widget="monetary"/>
                        <field name="order_sourcing_type" widget="badge"
                               decoration-success="order_sourcing_type == 'partner'"
                               decoration-warning="order_sourcing_type == 'outside'"/>
                        <field name="order_purchase_type" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
